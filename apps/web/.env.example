# Copy to .env.local for development. In Vercel, set these per environment (Production / Preview / Development).
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (EU project)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scam check (Claude API). Without a key, checks fall back to rule-based verdicts (never "safe").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=medium
# Speech-to-text for voice notes that weren't transcribed on the phone (ElevenLabs Scribe)
ELEVENLABS_API_KEY=
# Hours to keep raw screenshots/voice notes after analysis (0 = never stored)
RAW_MEDIA_RETENTION_HOURS=0

# Upstash: rate limits (Redis) and delayed jobs (QStash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Shared secret for Vercel Cron and internal job calls (32+ random characters)
CRON_SECRET=

# Family alerts
EXPO_ACCESS_TOKEN=
ALERT_ESCALATION_MINUTES=5
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER_ID=ALT

# Billing (Stripe, Greek entity, Stripe Tax on). Run `pnpm stripe:setup` once to create products/prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Resend, with a verified sending domain)
RESEND_API_KEY=
EMAIL_FROM=ΑΛΤ! <hello@alt.example>
SUPPORT_EMAIL=hello@alt.example
SALES_EMAIL=hello@alt.example

# Demo data for the org portal when Supabase is not configured (never in production)
ALT_DEMO_MODE=0

# Chat channels (off until the business accounts are approved)
FEATURE_VIBER=off
VIBER_AUTH_TOKEN=
VIBER_BOT_NAME=ΑΛΤ!
FEATURE_WHATSAPP=off
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# Analytics (PostHog EU) — events are allow-listed and contain no personal data
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Error reporting (Sentry, EU region: use a DSN on *.ingest.de.sentry.io)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only for source-map upload in CI/Vercel
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Organisation invoices: manual (admin issues them) until a myDATA provider is connected
INVOICING_PROVIDER=manual

# App Links / Universal Links (/.well-known)
APP_BUNDLE_ID=gr.alt.app
APPLE_TEAM_ID=
# SHA-256 of the Play app-signing certificate (comma-separated if several)
ANDROID_CERT_SHA256=
