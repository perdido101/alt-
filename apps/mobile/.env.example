# Public values only: these are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Website base URL, used for invite links (https://<web>/j/<token>) and App Links / Universal Links.
EXPO_PUBLIC_WEB_URL=https://alt.example
# Android applicationId / iOS bundle identifier (build-time only).
APP_BUNDLE_ID=gr.alt.app
EXPO_PUBLIC_API_URL=http://localhost:3000

# Analytics (PostHog EU) and error reporting (Sentry EU). Both optional.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
# Source maps on EAS builds
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
